        </mxCell>
        <mxCell id="c48a" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F5EE;strokeColor=#237A4A;strokeWidth=2;fontSize=12;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;b&gt;SÍ OPERA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ciclo mina completo: carguío, transporte, descarga y pesaje · identificación por proximidad · apertura y cierre de sesión · acceso contra caché · inspecciones, incidentes, detenciones, muestras y movimientos de stock" vertex="1">
          <mxGeometry height="210" width="460" x="1710" y="1265" as="geometry" />
        </mxCell>
        <mxCell id="c48b" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCECEB;strokeColor=#B62F2A;strokeWidth=2;fontSize=12;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;b&gt;NO OPERA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Alta de contratista nueva · cambios maestros · conciliación y cierre · &lt;b&gt;liberación de lote&lt;/b&gt; · publicación externa · tableros · alertas externas · telemetría de portales web" vertex="1">
          <mxGeometry height="210" width="460" x="2190" y="1265" as="geometry" />
        </mxCell>
        <mxCell id="c48c" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCF1E3;strokeColor=#B35F0C;strokeWidth=2;fontSize=12;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="&lt;b&gt;PROCEDIMIENTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;C-03 firma y guarda · C-04 persiste y muestra el contador de eventos pendientes · no se libera lote · al volver el enlace se reconcilia automáticamente en &lt;b&gt;≤4 h&lt;/b&gt; por identificador idempotente, sin duplicación, y se verifican totales" vertex="1">
          <mxGeometry height="210" width="480" x="2670" y="1265" as="geometry" />
        </mxCell>
        <mxCell id="Cfoot" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#237A4A;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=13;fontColor=#3D4C5A;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" value="CRITERIOS DE ACEPTACIÓN VERIFICABLES EN ESTA LÁMINA — ▸ Los cuatro nodos edge muestran almacenamiento persistente, enlace principal y alternativo, y autonomía de 48 horas.   ▸ La prueba de corte de 48 h conserva todos los eventos y la reconciliación termina en ≤4 h sin intervención manual.   ▸ La prueba OPC UA demuestra lectura autorizada y denegación auditada de Write y Call.   ▸ No se encuentra ninguna ruta directa Internet–datos ni TI–control industrial." vertex="1">
          <mxGeometry height="120" width="3120" x="60" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="Cnota" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F2F4;strokeColor=#5C6975;strokeWidth=2;fontSize=13;fontStyle=0;fontColor=#101A24;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" value="Nota de alcance: los sistemas existentes del CLIENTE (LIMS, despacho de flota, planificación, ERP, historiador y básculas) no se reemplazan. OVERFORE integra con adaptadores aislados y no instala componentes dentro de esos productos salvo agente autorizado y documentado." vertex="1">
          <mxGeometry height="60" width="3120" x="60" y="1700" as="geometry" />
        </mxCell>
      </root>
