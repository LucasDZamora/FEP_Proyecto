C-8200&lt;/b&gt;&lt;br&gt;store-and-forward" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#B35F0C;strokeColor=#ffffff;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#101A24;" vertex="1" parent="1"><mxGeometry x="2070" y="900" width="80" height="62" as="geometry"/></mxCell><mxCell id="cd4_i1" value="&lt;b&gt;Báscula de camiones&lt;/b&gt;&lt;br&gt;existente" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6975;strokeWidth=3;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#101A24;" vertex="1" parent="1"><mxGeometry x="2240" y="900" width="80" height="62" as="geometry"/></mxCell><mxCell id="cd4_i2" value="&lt;b&gt;Cola local 48 h&lt;/b&gt;&lt;br&gt;sincronización idempotente" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#237A4A;strokeColor=#ffffff;strokeWidth=2;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=10;fontColor=#101A24;" vertex="1" parent="1"><mxGeometry x="2410" y="900" width="80" height="62" as="geometry"/></mxCell><mxCell id="cd4_d" value="&lt;b&gt;Lo que la lámina debe mostrar:&lt;/b&gt; la dependencia de tercero en gris discontinuo y la cola de 48 h. No se asume SLA del operador portuario." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6975;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=12;fontColor=#3D4C5A;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1720" y="1025" width="780" height="110" as="geometry"/></mxCell><mxCell id="cd4_e" value="&lt;b&gt;Enlace principal:&lt;/b&gt; VPN sobre el enlace del operador portuario · TERCERO SIN SLA&lt;br&gt;&lt;br&gt;&lt;b&gt;Contingencia:&lt;/b&gt; Carrier celular empresarial independiente [VAL-06]&lt;br&gt;&lt;br&gt;&lt;b&gt;Gabinete industrial:&lt;/b&gt; IP54/IP65 · UPS local ≥60 min · sensor · cerradura · tierra · filtro de polvo" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6975;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=12;fontColor=#3D4C5A;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="2530" y="1025" width="610" height="110" as="geometry"/></mxCell><mxCell id="KC7" value="CAPTURA EN ORIGEN · C-03 Y ADMINISTRACIÓN DE DISPOSITIVOS" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=6;spacingLeft=14;fillColor=#FCF1E3;strokeColor=#B35F0C;strokeWidth=3;dashed=0;fontColor=#B35F0C;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="1210" width="1560" height="300" as="geometry"/></mxCell><mxCell id="c_tab" value="&lt;b&gt;Tableta rugerizada C-03&lt;/b&gt;&lt;br&gt;176 u. (160 + 16 stock)&lt;br&gt;IP65 · caída ≥1,2 m · −6 a 34 °C&lt;br&gt;sol directo · guantes · NFC · GNSS&lt;br&gt;12 h de batería · SQLite cifrado y firmado" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.networks.tablet;fillColor=#B35F0C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#101A24;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="110" y="1270" width="110" height="82" as="geometry"/></mxCell><mxCell id="c_lte" value="&lt;b&gt;LTE privado autorizado&lt;/b&gt;&lt;br&gt;del CLIENTE · sombras del rajo&lt;br&gt;estudio de cobertura RF" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.networks.radio_tower;fillColor=#B35F0C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#101A24;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="400" y="1270" width="100" height="82" as="geometry"/></mxCell><mxCell id="c_mdm" value="&lt;b&gt;MDM central&lt;/b&gt;&lt;br&gt;actualización por anillos&lt;br&gt;bloqueo y borrado remoto&lt;br&gt;10 % de stock en faena" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.networks.monitor;fillColor=#1268B4;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#101A24;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="680" y="1270" width="100" height="82" as="geometry"/></mxCell><mxCell id="c_lect" value="&lt;b&gt;Lector portátil de muestras&lt;/b&gt;&lt;br&gt;20 + 4 repuestos" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.networks.scanner;fillColor=#B35F0C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#101A24;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="950" y="1270" width="100" height="82" as="geometry"/></mxCell><mxCell id="c_imp" value="&lt;b&gt;Impresora de etiquetas&lt;/b&gt;&lt;br&gt;Zebra ZT411 · 8 + 2" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.networks.printer;fillColor=#B35F0C;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=12;fontColor=#101A24;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1220" y="1270" width="100" height="82" as="geometry"/></mxCell><mxCell id="EC7" value="LTE privado · el identificador y la firma nacen en el origen · registro local sin WAN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#B35F0C;strokeWidth=4;dashed=0;endArrow=block;endFill=1;startArrow=none;fontSize=11;fontColor=#101A24;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c_tab" target="c_sw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165" y="1190"/><mxPoint x="515" y="1190"/></Array></mxGeometry></mxCell><mxCell id="KC48" value="OPERACIÓN DURANTE 48 HORAS SIN ENLACE" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=6;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#B35F0C;strokeWidth=3;dashed=1;dashPattern=10 6;fontColor=#B35F0C;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1680" y="1210" width="1500" height="300" as="geometry"/></mxCell><mxCell id="c48a" value="&lt;b&gt;SÍ OPERA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ciclo mina completo: carguío, transporte, descarga y pesaje · identificación por proximidad · apertura y cierre de sesión · acceso contra caché · inspecciones, incidentes, detenciones, muestras y movimientos de stock" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F5EE;strokeColor=#237A4A;strokeWidth=2;fontSize=12;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1710" y="1265" width="460" height="210" as="geometry"/></mxCell><mxCell id="c48b" value="&lt;b&gt;NO OPERA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Alta de contratista nueva · cambios maestros · conciliación y cierre · &lt;b&gt;liberación de lote&lt;/b&gt; · publicación externa · tableros · alertas externas · telemetría de portales web" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCECEB;strokeColor=#B62F2A;strokeWidth=2;fontSize=12;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="2190" y="1265" width="460" height="210" as="geometry"/></mxCell><mxCell id="c48c" value="&lt;b&gt;PROCEDIMIENTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;C-03 firma y guarda · C-04 persiste y muestra el contador de eventos pendientes · no se libera lote · al volver el enlace se reconcilia automáticamente en &lt;b&gt;≤4 h&lt;/b&gt; por identificador idempotente, sin duplicación, y se verifican totales" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FCF1E3;strokeColor=#B35F0C;strokeWidth=2;fontSize=12;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="2670" y="1265" width="480" height="210" as="geometry"/></mxCell><mxCell id="Cfoot" value="CRITERIOS DE ACEPTACIÓN VERIFICABLES EN ESTA LÁMINA — ▸ Los cuatro nodos edge muestran almacenamiento persistente, enlace principal y alternativo, y autonomía de 48 horas.   ▸ La prueba de corte de 48 h conserva todos los eventos y la reconciliación termina en ≤4 h sin intervención manual.   ▸ La prueba OPC UA demuestra lectura autorizada y denegación auditada de Write y Call.   ▸ No se encuentra ninguna ruta directa Internet–datos ni TI–control industrial." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#237A4A;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=13;fontColor=#3D4C5A;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="1560" width="3120" height="120" as="geometry"/></mxCell><mxCell id="Cnota" value="Nota de alcance: los sistemas existentes del CLIENTE (LIMS, despacho de flota, planificación, ERP, historiador y básculas) no se reemplazan. OVERFORE integra con adaptadores aislados y no instala componentes dentro de esos productos salvo agente autorizado y documentado." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0F2F4;strokeColor=#5C6975;strokeWidth=2;fontSize=13;fontStyle=0;fontColor=#101A24;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="60" y="1700" width="3120" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="leyenda" name="Leyenda, zonas e índice K"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="2680" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="LEYENDA, CONVENCIÓN VISUAL, ZONAS E ÍNDICE DE CONTENEDORES" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#17365D;fontColor=#FFFFFF;fontSize=28;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="2520" height="64" as="geometry"/></mxCell><mxCell id="subtitle" value="Convención del §16.4 del Subdocumento 4.2  ·  Todas las láminas usan los mismos nombres, colores y tipos de línea  ·  Todos los modelos admiten «o equivalente»" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EDF4;strokeColor=#17365D;strokeWidth=2;fontSize=14;fontStyle=0;fontColor=#101A24;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="2520" height="36" as="geometry"/></mxCell><mxCell id="LG1" value="FORMAS POR TIPO DE EQUIPO" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=6;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=3;dashed=0;fontColor=#17365D;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="1230" height="690" as="geometry"/></mxCell><mxCell id="LF0" value="Nube / dominio remoto" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.networks.cloud;fillColor=#5C6975;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#101A24;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="90" y="205" width="62" height="56" as="geometry"/></mxCell><mxCell id="LF1" value="Router" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.networks.router;fillColor=#1268B4;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#101A24;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="326" y="205" width="62" height="56" as="geometry"/></mxCell><mxCell id="LF2" value="Switch" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.networks.switch;fillColor=#237A4A;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=11;fontColor=#101A24;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="562" y="205" width="62" height="56" as="geometry"/></mxCell><mxCell id="LF3" value="Firewall NGFW" style="sketch=0;html=1;outlineConnect=0;shape=mxgraph.networks.firewall;fillColor=#B62F2A;strokeColor=#ffffff;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontSize=