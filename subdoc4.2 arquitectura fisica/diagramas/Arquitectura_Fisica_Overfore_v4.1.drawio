ml=1;verticalAlign=top;align=left;spacingTop=6;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=3;dashed=0;fontColor=#17365D;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="2170" width="2520" height="350" as="geometry"/></mxCell><mxCell id="LZZ1" value="&lt;b&gt;Z1 · DMZ pública&lt;/b&gt; — WAF y origen de C-06 y C-07. Sin acceso directo a datos." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1268B4;strokeWidth=2;fontSize=11;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="2225" width="1200" height="64" as="geometry"/></mxCell><mxCell id="LZZ2" value="&lt;b&gt;Z2 · Puerta operacional&lt;/b&gt; — VPN/mTLS desde Faena, CIO y edge; límites de tasa y validación técnica." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1268B4;strokeWidth=2;fontSize=11;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="2297" width="1200" height="64" as="geometry"/></mxCell><mxCell id="LZZ3" value="&lt;b&gt;Z3 · Aplicaciones&lt;/b&gt; — Servicios sin estado y consumidores; subred privada." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1268B4;strokeWidth=2;fontSize=11;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="2369" width="1200" height="64" as="geometry"/></mxCell><mxCell id="LZZ4" value="&lt;b&gt;Z4 · Datos&lt;/b&gt; — PostgreSQL, TimescaleDB, objetos, ClickHouse, OpenSearch y Redis; sólo endpoints privados." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1268B4;strokeWidth=2;fontSize=11;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="70" y="2441" width="1200" height="64" as="geometry"/></mxCell><mxCell id="LZZ5" value="&lt;b&gt;Z5 · Gestión&lt;/b&gt; — Bastión/PAM, observabilidad, parches, MDM y automatización." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1268B4;strokeWidth=2;fontSize=11;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1300" y="2225" width="1200" height="64" as="geometry"/></mxCell><mxCell id="LZZ6" value="&lt;b&gt;Z6 · TI corporativa&lt;/b&gt; — Usuarios, ERP y sistemas administrativos mediante integraciones controladas." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5C6975;strokeWidth=2;fontSize=11;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1300" y="2297" width="1200" height="64" as="geometry"/></mxCell><mxCell id="LZZ7" value="&lt;b&gt;Z7 · DMZ TI/TO&lt;/b&gt; — C-14 primario y reserva; allowlist OPC UA; sin ruta desde cloud a PLC o DCS." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B35F0C;strokeWidth=2;fontSize=11;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1300" y="2369" width="1200" height="64" as="geometry"/></mxCell><mxCell id="LZZ8" value="&lt;b&gt;Z8 · Respaldo&lt;/b&gt; — Credenciales separadas, repositorio inmutable y restauración controlada." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6A48B0;strokeWidth=2;fontSize=11;fontStyle=0;fontColor=#101A24;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1300" y="2441" width="1200" height="64" as="geometry"/></mxCell><mxCell id="Lfoot" value="Regla inamovible: se mantiene el ID y el nombre de cada componente tal como aparece en el Subdocumento 4.1 v4.2. El plano físico ubica; no renombra, no fusiona y no inventa componentes lógicos nuevos. Las marcas citadas son referencias para cotizar: la especificación final debe usar «o equivalente», verificar fin de venta y soporte, garantía en Chile, repuestos, licencias, rango térmico y homologación de altura para 3.180 m." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#17365D;strokeWidth=1;dashed=1;dashPattern=4 3;fontSize=13;fontColor=#3D4C5A;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="2545" width="2520" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>