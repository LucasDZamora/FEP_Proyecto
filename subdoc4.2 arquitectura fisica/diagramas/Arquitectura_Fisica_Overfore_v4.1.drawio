        <mxCell id="KC48" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=6;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#B35F0C;strokeWidth=3;dashed=1;dashPattern=10 6;fontColor=#B35F0C;fontSize=17;fontStyle=1;" value="OPERACIÓN DURANTE 48 HORAS SIN ENLACE" vertex="1">
